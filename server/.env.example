NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/laptop_management
JWT_SECRET=replace-with-a-long-random-secret
# Set each to a separate 32-byte key encoded as 64 hex characters or base64.
LICENSE_ENCRYPTION_KEY=
LICENSE_HMAC_KEY=
# Optional. Defaults to server/private-invoices, outside public static files.
INVOICE_STORAGE_DIR=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# SMTP settings required to email real OTPs
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Laptop Management <no-reply@example.com>"
# Optional local development convenience. Never enable in production.
AUTH_EXPOSE_OTP=false
